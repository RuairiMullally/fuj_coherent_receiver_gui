FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml /app/
COPY src/ /app/src/

RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir .

EXPOSE 8050

CMD ["gunicorn", "fuj_gui.wsgi:server", \
     "--workers", "1", \
     "--threads", "4", \
     "--bind",    "0.0.0.0:8050", \
     "--timeout", "120"]
